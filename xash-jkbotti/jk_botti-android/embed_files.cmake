# Generates a C++ file with the jk_botti addon files embedded as byte arrays.
# Inputs: ADDON_DIR, OUT, LIST (file holding a ;-list of paths relative to ADDON_DIR)
file(READ "${LIST}" FILES)
set(body "")
set(table "")
set(i 0)
foreach(rel IN LISTS FILES)
	file(READ "${ADDON_DIR}/${rel}" hex HEX)
	string(LENGTH "${hex}" hexlen)
	math(EXPR size "${hexlen} / 2")
	string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
	string(REGEX REPLACE "((0x..,){32})" "\\1\n" bytes "${bytes}")
	string(APPEND body "static const unsigned char f${i}[] = {\n${bytes}0x00};\n")
	string(APPEND table "\t{ \"${rel}\", f${i}, ${size} },\n")
	math(EXPR i "${i} + 1")
endforeach()

file(WRITE "${OUT}.tmp" "// generated by embed_files.cmake, do not edit
#include <stddef.h>
#include \"android_addon.h\"
${body}
const jk_embedded_file_t jk_embedded_files[] = {
${table}\t{ NULL, NULL, 0 }
};
")
file(RENAME "${OUT}.tmp" "${OUT}")
