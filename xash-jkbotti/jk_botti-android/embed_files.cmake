# Generates a C++ file with the jk_botti addon files embedded as byte arrays.
# Inputs: OUT, LIST (file holding a ;-list of "rel|source[|legacy]" entries)
file(READ "${LIST}" ENTRIES)

set(body "")
set(table "")
set(i 0)

# emit <var> <file>: appends a byte array named <var>, sets <var>_size
macro(emit var src)
	file(READ "${src}" hex HEX)
	string(LENGTH "${hex}" hexlen)
	math(EXPR ${var}_size "${hexlen} / 2")
	string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
	string(REGEX REPLACE "((0x..,){32})" "\\1\n" bytes "${bytes}")
	string(APPEND body "static const unsigned char ${var}[] = {\n${bytes}0x00};\n")
endmacro()

foreach(entry IN LISTS ENTRIES)
	string(REPLACE "|" ";" parts "${entry}")
	list(LENGTH parts nparts)
	list(GET parts 0 rel)
	list(GET parts 1 src)
	emit(f${i} "${src}")
	if(nparts GREATER 2)
		list(GET parts 2 legacy)
		emit(l${i} "${legacy}")
		string(APPEND table "\t{ \"${rel}\", f${i}, ${f${i}_size}, l${i}, ${l${i}_size} },\n")
	else()
		string(APPEND table "\t{ \"${rel}\", f${i}, ${f${i}_size}, NULL, 0 },\n")
	endif()
	math(EXPR i "${i} + 1")
endforeach()

file(WRITE "${OUT}.tmp" "// generated by embed_files.cmake, do not edit
#include <stddef.h>
#include \"android_addon.h\"
${body}
const jk_embedded_file_t jk_embedded_files[] = {
${table}\t{ NULL, NULL, 0, NULL, 0 }
};
")
file(RENAME "${OUT}.tmp" "${OUT}")
