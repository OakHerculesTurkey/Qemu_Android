--- a/bot_query_hook_linux.cpp
+++ b/bot_query_hook_linux.cpp
@@ -4,7 +4,7 @@
 // bot_query_hook_linux.cpp
 //
 
-#ifndef _WIN32
+#if !defined(_WIN32) && (defined(__i386__) || defined(__x86_64__))
 
 #ifndef __USE_GNU
 #define __USE_GNU
@@ -216,3 +216,25 @@ bool unhook_sendto_function(void)
 }
 
 #endif /*!_WIN32*/
+
+#if !defined(_WIN32) && !(defined(__i386__) || defined(__x86_64__))
+// Non-x86 (ARM64 Android etc.): no in-memory patching of sendto(). The
+// server-query connection-time faking (bot_conntimes) is simply unavailable.
+#include <sys/socket.h>
+#include "bot_query_hook.h"
+
+ssize_t call_original_sendto(int socket, const void *message, size_t length, int flags, const struct sockaddr *dest_addr, socklen_t dest_len)
+{
+   return sendto(socket, message, length, flags, dest_addr, dest_len);
+}
+
+bool hook_sendto_function(void)
+{
+   return(false);
+}
+
+bool unhook_sendto_function(void)
+{
+   return(true);
+}
+#endif
