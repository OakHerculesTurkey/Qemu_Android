diff --git a/bot_query_hook_linux.cpp b/bot_query_hook_linux.cpp
index e5f1752..4ba542b 100644
--- a/bot_query_hook_linux.cpp
+++ b/bot_query_hook_linux.cpp
@@ -4,7 +4,7 @@
 // bot_query_hook_linux.cpp
 //
 
-#ifndef _WIN32
+#if !defined(_WIN32) && (defined(__i386__) || defined(__x86_64__))
 
 #ifndef __USE_GNU
 #define __USE_GNU
@@ -216,3 +216,25 @@ bool unhook_sendto_function(void)
 }
 
 #endif /*!_WIN32*/
+
+#if !defined(_WIN32) && !(defined(__i386__) || defined(__x86_64__))
+// Non-x86 (ARM64 Android etc.): no in-memory patching of sendto(). The
+// server-query connection-time faking (bot_conntimes) is simply unavailable.
+#include <sys/socket.h>
+#include "bot_query_hook.h"
+
+ssize_t call_original_sendto(int socket, const void *message, size_t length, int flags, const struct sockaddr *dest_addr, socklen_t dest_len)
+{
+   return sendto(socket, message, length, flags, dest_addr, dest_len);
+}
+
+bool hook_sendto_function(void)
+{
+   return(false);
+}
+
+bool unhook_sendto_function(void)
+{
+   return(true);
+}
+#endif
diff --git a/commands.cpp b/commands.cpp
index a9b0691..f9d57dc 100644
--- a/commands.cpp
+++ b/commands.cpp
@@ -1318,6 +1318,53 @@ FORCE_STACK_ALIGN void jk_botti_ServerCommand (void)
          UTIL_ConsolePrintf("Disabled min_bots/max_bots.");
       }
    }
+   else if(FStrEq(CMD_ARGV(1), "kickbot"))
+   {
+      // kick one bot: "kickbot" picks a random one, "kickbot <name>" a named one
+      const char *name = CMD_ARGV(2);
+      int pick = -1;
+
+      if(name && *name)
+      {
+         for (int index = 0; index < 32; index++)
+         {
+            if (bots[index].is_used && !FNullEnt(bots[index].pEdict) &&
+                stricmp(STRING(bots[index].pEdict->v.netname), name) == 0)
+            {
+               pick = index;
+               break;
+            }
+         }
+      }
+      else
+         pick = UTIL_PickRandomBot();
+
+      if(pick == -1)
+      {
+         UTIL_ConsolePrintf("No bot to kick.");
+      }
+      else
+      {
+         UTIL_ConsolePrintf("Kicking bot %s.", STRING(bots[pick].pEdict->v.netname));
+         BotKick(bots[pick]);
+
+         // don't let min_bots add it straight back
+         if(min_bots > 0)
+         {
+            int bot_count = 0;
+            for (int index = 0; index < 32; index++)
+               if (bots[index].is_used)
+                  bot_count++;
+            if(bot_count - 1 < min_bots)
+            {
+               min_bots = bot_count - 1;
+               if(max_bots != -1 && max_bots < min_bots)
+                  max_bots = min_bots;
+               UTIL_ConsolePrintf("min_bots lowered to %d.", min_bots);
+            }
+         }
+      }
+   }
    else if(!ProcessCommand(SRVCMD_TYPE, print_to_server_output, NULL, CMD_ARGV (1), CMD_ARGV (2), CMD_ARGV (3), CMD_ARGV (4), CMD_ARGV (5), CMD_ARGV (6)))
    {
       UTIL_ConsolePrintf("%s: Unknown command \'%s\'\n", CMD_ARGV(0), CMD_ARGS());
