diff --git a/metamod/src/game_support.cpp b/metamod/src/game_support.cpp
index 36ff5bb..ecde25c 100644
--- a/metamod/src/game_support.cpp
+++ b/metamod/src/game_support.cpp
@@ -252,6 +252,41 @@ bool setup_gamedll(gamedll_t *gamedll)
 		knownfn = libpath;
 	}
 
+#ifdef __ANDROID__
+	// Android: game libraries can't be loaded from shared storage, they are
+	// shipped inside a launcher APK. The launcher passes MM_GAMEDLL (absolute
+	// path), or at least XASH3D_GAMELIBDIR (APK native library directory).
+	if (!g_config->m_gamedll) {
+		const char *env_dll = getenv("MM_GAMEDLL");
+		const char *libdir = getenv("XASH3D_GAMELIBDIR");
+		char guess[MAX_PATH] = "";
+
+		if (env_dll && *env_dll) {
+			Q_strlcpy(guess, env_dll);
+		}
+		else if (libdir && *libdir) {
+			for (auto& k : g_known_games) {
+				if (!k.name || Q_stricmp(k.name, gamedll->name) || !k.linux_so)
+					continue;
+				char stem[MAX_PATH], libname[MAX_PATH];
+				const char *base = Q_strrchr(k.linux_so, '/');
+				Q_strlcpy(stem, base ? base + 1 : k.linux_so);
+				char *dot = Q_strrchr(stem, '.');
+				if (dot) *dot = '\0';
+				COM_StripIntelSuffix(stem);
+				COM_GenerateCommonLibraryName(stem, libname, sizeof libname);
+				Q_snprintf(guess, sizeof guess, "%s/%s", libdir, libname);
+				break;
+			}
+		}
+
+		if (guess[0] && is_file_exists(guess)) {
+			g_config->m_gamedll = Q_strdup(guess);
+			META_LOG("Android: using game DLL from launcher: %s", guess);
+		}
+	}
+#endif
+
 	// Use override-dll if specified.
 	if (g_config->m_gamedll) {
 		Q_strlcpy(gamedll->pathname, g_config->m_gamedll);
diff --git a/metamod/src/mlist.cpp b/metamod/src/mlist.cpp
index 47a6ca3..7fef03c 100644
--- a/metamod/src/mlist.cpp
+++ b/metamod/src/mlist.cpp
@@ -226,6 +226,32 @@ bool MPluginList::ini_startup()
 	int n, ln;
 
 	if (!is_file_exists_in_gamedir(m_inifile)) {
+		// No plugins.ini: accept a space separated list of plugin paths in
+		// MM_PLUGINS (set by the Android launcher, also usable elsewhere).
+		const char *env = getenv("MM_PLUGINS");
+		if (env && *env) {
+			char list[4096];
+			Q_strlcpy(list, env);
+			n = 0;
+			char *save = nullptr;
+			for (char *tok = strtok_r(list, " ;", &save); tok; tok = strtok_r(nullptr, " ;", &save)) {
+				char line[MAX_STRBUF_LEN];
+				Q_snprintf(line, sizeof line, "linux %s", tok);
+				auto plug = new MPlugin();
+				if (!plug->ini_parseline(line) || find(plug->m_pathname)) {
+					delete plug;
+					continue;
+				}
+				plug->m_index = ++m_last_index;
+				plug->m_action = PA_LOAD;
+				m_plugins.push_back(plug);
+				META_LOG("env: Read plugin config for: %s", plug->m_desc);
+				n++;
+			}
+			META_LOG("env: Found %d plugins to load from MM_PLUGINS", n);
+			return true;
+		}
+
 		META_ERROR("ini: Metamod plugins file empty or missing: %s", m_inifile);
 		return false;
 	}
@@ -308,6 +334,16 @@ bool MPluginList::ini_refresh()
 
 	FILE* fp = fopen(m_inifile, "r");
 	if (!fp) {
+		// Plugins came from MM_PLUGINS at startup: keep them as they are.
+		const char *env = getenv("MM_PLUGINS");
+		if (env && *env) {
+			for (auto p : m_plugins) {
+				if (p->m_status >= PL_VALID && (p->m_action == PA_NONE || p->m_action == PA_NULL))
+					p->m_action = PA_KEEP;
+			}
+			return true;
+		}
+
 		META_ERROR("ini: Unable to open plugins file '%s': %s", m_inifile, strerror(errno));
 		return false;
 	}
