 const char *MPlugin::s_rPrintLoadTime[][4] = {
 	// SL_SIMPLE		// SL_SHOW	// SL_ALLOWED					// SL_NOW
@@ -239,6 +240,32 @@ bool MPlugin::resolve()
 	else
 		found = resolve_dirs(m_filename, tempbuf, sizeof tempbuf);
 
+#ifdef __ANDROID__
+	// Android: plugins are shipped as lib<name>_android_<arch>.so inside the
+	// launcher APK; try that directory using the bare file name.
+	const char *libdir = getenv("XASH3D_GAMELIBDIR");
+	if (!found && libdir && *libdir) {
+		const char *base = Q_strrchr(m_filename, '/');
+		base = base ? base + 1 : m_filename;
+
+		char stem[MAX_PATH], libname[MAX_PATH], buf[MAX_PATH];
+		Q_strlcpy(stem, base);
+		char *dot = Q_strrchr(stem, '.');
+		if (dot && !Q_strcmp(dot, ".so")) *dot = '\0';
+		COM_StripIntelSuffix(stem);
+
+		const char *candidates[3] = { base, stem, nullptr };
+		COM_GenerateCommonLibraryName(stem, libname, sizeof libname);
+		candidates[2] = libname;
+
+		for (const char *c : candidates) {
+			Q_snprintf(buf, sizeof buf, "%s/%s", libdir, c);
+			if ((found = resolve_suffix(buf, tempbuf, sizeof tempbuf)))
+				break;
+		}
+	}
+#endif
+
 	if (!found) {
 		META_DEBUG(2, "Couldn't resolve '%s' to file", m_filename);
 		return false;
