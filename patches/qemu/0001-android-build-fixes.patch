@@ -982,6 +983,17 @@ void qemu_close_all_open_fd(const int *skip, unsigned int nskip)
     }
 }
 
+#ifdef __ANDROID__
+/*
+ * Android (bionic) does not provide POSIX shared memory (shm_open). An
+ * anonymous memfd gives the same semantics: an fd backed by shared memory
+ * that is released once the last reference is closed.
+ */
+int qemu_shm_alloc(size_t size, Error **errp)
+{
+    return qemu_memfd_create("qemu-shm", size, false, 0, 0, errp);
+}
+#else
 int qemu_shm_alloc(size_t size, Error **errp)
 {
     g_autoptr(GString) shm_name = g_string_new(NULL);
